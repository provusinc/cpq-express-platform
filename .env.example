# CPQ Express — local environment.
# Copy to `.env` at the repo root: `cp .env.example .env`. Every app and package
# reads this one root file (package scripts load it with `dotenv -e ../../.env`).
# Values below match docker-compose.yml.

# ─── Database (Postgres 17, docker compose) ──────────────────────────────────
# App database. `pnpm db:migrate` applies migrations here.
DATABASE_URL=postgres://cpq:cpq@localhost:5432/cpq
# Dedicated test database (created by docker/postgres/init-test-db.sql).
# API tests migrate it in globalSetup and roll back every test's transaction.
TEST_DATABASE_URL=postgres://cpq:cpq@localhost:5432/cpq_test
# Host port overrides for docker compose (only if the defaults collide; keep the
# URLs above in sync).
# POSTGRES_PORT=5432
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# ─── App / domains ───────────────────────────────────────────────────────────
# Organizations live at {slug}.<ROOT_DOMAIN>; sign-in at app.<ROOT_DOMAIN>, the
# Platform Admin console at admin.<ROOT_DOMAIN>. localtest.me (and every
# subdomain of it) resolves to 127.0.0.1, so no /etc/hosts edits are needed.
ROOT_DOMAIN=localtest.me
# Public base URL of the sign-in app (used for links in emails, redirects).
APP_URL=http://app.localtest.me:3000
# Port for `next dev` / `next start`.
PORT=3000

# ─── Object storage (S3-compatible; MinIO locally) ───────────────────────────
# Quote Documents and Organization logos. Console: http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cpq-minio
S3_SECRET_ACCESS_KEY=cpq-minio-secret
S3_BUCKET=cpq-documents
# MinIO needs path-style URLs (http://host/bucket/key).
S3_FORCE_PATH_STYLE=true

# ─── Email (SMTP; Mailpit locally) ───────────────────────────────────────────
# Magic links and Invitations. Mailpit UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# Mailpit accepts any credentials; leave empty locally.
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS (port 465). STARTTLS is negotiated automatically otherwise.
SMTP_SECURE=false
EMAIL_FROM="CPQ Express <no-reply@localtest.me>"

# ─── Auth (Auth.js) ──────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional OAuth providers — each is enabled only when its credentials are set.
# Google: redirect URI http://app.localtest.me:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID: redirect URI http://app.localtest.me:3000/api/auth/callback/microsoft-entra-id
# Issuer e.g. https://login.microsoftonline.com/<tenant-id>/v2.0 (or .../common/v2.0)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ─── Tooling ─────────────────────────────────────────────────────────────────
# Set to 1 to skip env validation (e.g. CI lint/build without real services).
# SKIP_ENV_VALIDATION=1
