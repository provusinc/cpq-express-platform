{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./env": "./src/env.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:migrate": "pnpm with-env tsx src/migrate.ts",
    "db:migrate:test": "pnpm with-env tsx src/migrate.ts --test",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "db:seed": "pnpm with-env tsx src/seed/index.ts"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
