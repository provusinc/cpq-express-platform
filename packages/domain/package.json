{
  "name": "@workspace/domain",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
