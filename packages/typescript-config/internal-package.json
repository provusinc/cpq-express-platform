{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Internal package (TS source consumed directly, no build step)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  }
}
